# AuraTwin AI Environment Variables

# Backend
API_V1_STR=/api
PROJECT_NAME="AuraTwin AI V2"

# Security foundation (development/demo only)
# Generate a random secret with at least 32 characters. Never commit real values.
AURATWIN_JWT_SECRET=
AURATWIN_JWT_ALGORITHM=HS256
AURATWIN_ACCESS_TOKEN_EXPIRE_MINUTES=30
AURATWIN_BOOTSTRAP_ADMIN_EMAIL=
AURATWIN_BOOTSTRAP_ADMIN_PASSWORD=
# Optional initial operator account; assigned only to the configured local building.
AURATWIN_BOOTSTRAP_OPERATOR_EMAIL=
AURATWIN_BOOTSTRAP_OPERATOR_PASSWORD=
AURATWIN_BOOTSTRAP_OPERATOR_BUILDING_ID=development-building
AURATWIN_CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# Lyzr Integration
INTELLIGENCE_PROVIDER=mock
LYZR_API_KEY=your_lyzr_api_key_here
LYZR_AGENT_ID=your_lyzr_agent_id_here
LYZR_USER_ID=auratwin-service
LYZR_API_URL=https://agent-prod.studio.lyzr.ai/v3/inference/chat/
LYZR_TIMEOUT_SECONDS=8

# n8n Integration
N8N_WEBHOOK_URL=http://localhost:5678/webhook/auratwin-event

# Building control boundary (local simulation; no BACnet network connection)
BUILDING_CONTROL_PROVIDER=simulated_bacnet
RECOMMENDATION_TTL_SECONDS=60
DEMO_PHASE_DURATION_SECONDS=20

# Required command safety policy. Set only from an explicitly approved
# building/deployment policy; AuraTwin has no production defaults.
COMMAND_LIMIT_MIN_SETPOINT=
COMMAND_LIMIT_MAX_SETPOINT=
COMMAND_LIMIT_MAX_DELTA=

# Optional Phase 10.1 quality policies. No sensor freshness or temperature
# limits are assumed; configure limits only from an approved signal policy.
# DATA_QUALITY_MAX_AGE_OCCUPANCY_SECONDS=
# DATA_QUALITY_MAX_AGE_TEMPERATURE_SECONDS=
# DATA_QUALITY_MAX_AGE_SETPOINT_SECONDS=
# DATA_QUALITY_MAX_AGE_ENERGY_SECONDS=
# DATA_QUALITY_MAX_AGE_TARIFF_SECONDS=
# DATA_QUALITY_TEMPERATURE_MIN=
# DATA_QUALITY_TEMPERATURE_MAX=
# DATA_QUALITY_POWER_KW_MIN=
# DATA_QUALITY_POWER_KW_MAX=
# DATA_QUALITY_ENERGY_MIN=
# DATA_QUALITY_ENERGY_MAX=
# DATA_QUALITY_ENERGY_COST_MIN=
# DATA_QUALITY_ENERGY_COST_MAX=
# DATA_QUALITY_TARIFF_RATE_MIN=
# DATA_QUALITY_TARIFF_RATE_MAX=
# DATA_QUALITY_SETPOINT_MIN=
# DATA_QUALITY_SETPOINT_MAX=
# DATA_QUALITY_FUTURE_CLOCK_SKEW_SECONDS=0

# Future BACnet/IP configuration only; not read by the current simulator.
# BACNET_DEVICE_ADDRESS=
# BACNET_PORT=47808
# BACNET_DEVICE_ID=
# BACNET_TIMEOUT_SECONDS=3

# Occupancy Provider (mock | yolo)
OCCUPANCY_PROVIDER=mock

# Camera Provider (mock | rtsp). Configure zone-specific URLs only in .env;
# never commit URLs that may contain camera credentials.
CAMERA_PROVIDER=mock
RTSP_OPEN_TIMEOUT_MS=5000
RTSP_READ_TIMEOUT_MS=5000

# YOLO Configuration (only used when OCCUPANCY_PROVIDER=yolo)
YOLO_MODEL_PATH=yolov8n.pt
YOLO_CONFIDENCE=0.40
YOLO_DEVICE=auto
