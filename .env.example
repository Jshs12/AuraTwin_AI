# AuraTwin AI Environment Variables

# Backend
API_V1_STR=/api
PROJECT_NAME="AuraTwin AI V2"

# Lyzr Integration
INTELLIGENCE_PROVIDER=mock
LYZR_API_KEY=your_lyzr_api_key_here
LYZR_AGENT_ID=your_lyzr_agent_id_here
LYZR_USER_ID=auratwin-service
LYZR_API_URL=https://agent-prod.studio.lyzr.ai/v3/inference/chat/
LYZR_TIMEOUT_SECONDS=8

# n8n Integration
N8N_WEBHOOK_URL=http://localhost:5678/webhook/auratwin-event

# Building control boundary (local simulation; no BACnet network connection)
BUILDING_CONTROL_PROVIDER=simulated_bacnet
RECOMMENDATION_TTL_SECONDS=60
DEMO_PHASE_DURATION_SECONDS=20

# Future BACnet/IP configuration only; not read by the current simulator.
# BACNET_DEVICE_ADDRESS=
# BACNET_PORT=47808
# BACNET_DEVICE_ID=
# BACNET_TIMEOUT_SECONDS=3

# Occupancy Provider (mock | yolo)
OCCUPANCY_PROVIDER=mock

# Camera Provider (mock | rtsp). Configure zone-specific URLs only in .env;
# never commit URLs that may contain camera credentials.
CAMERA_PROVIDER=mock
RTSP_OPEN_TIMEOUT_MS=5000
RTSP_READ_TIMEOUT_MS=5000

# YOLO Configuration (only used when OCCUPANCY_PROVIDER=yolo)
YOLO_MODEL_PATH=yolov8n.pt
YOLO_CONFIDENCE=0.40
YOLO_DEVICE=auto
